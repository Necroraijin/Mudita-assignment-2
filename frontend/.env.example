# ============================================================
# MA2 Frontend — Environment Variables
# ============================================================

# ---------- Local Development ----------
# Points directly to the backend (CORS-based)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ---------- Vercel Production ----------
# Do NOT set NEXT_PUBLIC_API_URL on Vercel.
# Instead, set BACKEND_URL (server-side only) to the Cloud Run URL.
# Next.js rewrites will proxy /api/* to the backend (no CORS needed).
#
# BACKEND_URL=https://ma2-backend-xxxxx-uc.a.run.app
