# ============================================================
# MA2 Backend — Environment Variables
# ============================================================
# Copy to .env for local development.
# In production (GCP Cloud Run), these are set via Cloud Build
# and Secret Manager — never commit real values.
# ============================================================

# ---------- Application ----------
DEBUG=true
ENVIRONMENT=development
PORT=8000

# ---------- Database (local dev / Docker) ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ma2
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/ma2

# ---------- GCP Cloud SQL (production — set by Cloud Build) ----------
# USE_CLOUD_SQL_CONNECTOR=true
# CLOUD_SQL_INSTANCE=project:region:instance
# CLOUD_SQL_DATABASE=ma2
# CLOUD_SQL_USER=ma2-app
# CLOUD_SQL_PASSWORD=  (injected from Secret Manager)
# GCP_PROJECT_ID=your-project-id

# ---------- Google Generative AI (Gemini) ----------
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# ---------- CORS ----------
# Local dev: allow frontend on localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
# Production: set to your Vercel domain
# CORS_ORIGINS=["https://your-app.vercel.app"]

# ---------- Agent Config ----------
MAX_REVIEW_CYCLES=3
MAX_TRANSCRIPT_LENGTH=50000
MAX_RULES_LENGTH=10000
